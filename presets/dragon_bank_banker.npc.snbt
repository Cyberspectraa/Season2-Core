    DialogData:{
      DialogDataSet:[{
        Buttons:[{
          Actions:[{
            Cmd:"/dragonbank @initiator",Type:"COMMAND"
          }],Label:"open_bank",Name:"I'd like to access my account."
        },{
          Actions:[{
            Cmd:"bank_info",Type:"OPEN_NAMED_DIALOG"
          }],Label:"bank_info_button",Name:"How does the bank work?"
        },{
          Actions:[{
            Cmd:"coin_values",Type:"OPEN_NAMED_DIALOG"
          }],Label:"coin_values_button",Name:"What are the coin values?"
        },{
          Actions:[{
            Cmd:"farewell",Type:"OPEN_NAMED_DIALOG"
          }],Label:"leave_button",Name:"Nothing today, thank you."
        }],
        Label:"greeting",
        Name:"Banker Greeting",
        Priority:10,
        Texts:[{
          Text:"Good day, @initiator. Welcome to the Dragon Bank. What business brings you to my counter?"
        },{
          Text:"Ah, @initiator. Another day, another ledger. How may I help you?"
        },{
          Text:"Welcome, @initiator. Coin is safer in a ledger than loose in a pocket. What can I do for you?"
        }]
      },{
        Buttons:[{
          Actions:[{
            Cmd:"/dragonbank @initiator",Type:"COMMAND"
          }],Label:"bank_info_open",Name:"Open my account."
        },{
          Actions:[{
            Cmd:"coin_values",Type:"OPEN_NAMED_DIALOG"
          }],Label:"bank_info_values",Name:"What are the coin values?"
        },{
          Actions:[{
            Cmd:"greeting",Type:"OPEN_NAMED_DIALOG"
          }],Label:"bank_info_back",Name:"Back."
        }],
        Label:"bank_info",
        Name:"How the Bank Works",
        Priority:-1,
        Texts:[{
          Text:"Simple enough. Hand over any Dragon Currency coins and their value is recorded in your account. This counter currently accepts deposits only, so your stored balance stays safely in the bank's ledger for the future."
        }]
      },{
        Buttons:[{
          Actions:[{
            Cmd:"/dragonbank @initiator",Type:"COMMAND"
          }],Label:"values_open",Name:"Open my account."
        },{
          Actions:[{
            Cmd:"bank_info",Type:"OPEN_NAMED_DIALOG"
          }],Label:"values_info",Name:"How does the bank work?"
        },{
          Actions:[{
            Cmd:"greeting",Type:"OPEN_NAMED_DIALOG"
          }],Label:"values_back",Name:"Back."
        }],
        Label:"coin_values",
        Name:"Coin Values",
        Priority:-1,
        Texts:[{
          Text:"Our rates are fixed: Copper is worth 1, Silver 10, Gold 100, Platinum 1,000, and a Dragon Coin 10,000. The ledger records the total value of whatever denominations you deposit."
        }]
      },{
        Buttons:[{
          Actions:[{
            Type:"CLOSE_DIALOG"
          }],Label:"farewell_close",Name:"Farewell."
        }],
        Label:"farewell",
        Name:"Farewell",
        Priority:-1,
        Texts:[{
          Text:"Very well, @initiator. Your account will be here when you need it. Safe travels—and keep an eye on loose coin."
        }]
      }],
      Type:"CUSTOM"
    },
